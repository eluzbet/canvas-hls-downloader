{
  "manifest_version": 3,
  "name": "Canvas HLS Downloader",
  "version": "0.3.0",
  "description": "Detects analyzes and downloads unencrypted MPEG TS HLS videos from FIU Canvas",
  "permissions": [
    "storage",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://fiu.instructure.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/hls.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://fiu.instructure.com/*"
      ],
      "js": [
        "content/canvas-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Canvas HLS Downloader",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
